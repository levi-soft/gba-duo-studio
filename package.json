{
  "name": "gba-duo-studio",
  "private": true,
  "version": "0.3.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "vitest run",
    "check:source": "node scripts/check-game-neutral.mjs && node scripts/check-preview-independence.mjs",
    "verify": "npm run check:source && npm run check && npm test && npm run build",
    "source:zip": "node scripts/prepare-source.mjs",
    "notices:generate": "node scripts/dependency-notices.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.12",
    "wasmoon": "^1.16.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "jszip": "^3.10.2"
  },
  "description": "Game-neutral visual companion editor for GBA Duo",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.17.0"
  }
}
